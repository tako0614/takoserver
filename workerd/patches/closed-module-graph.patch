+    v8::Isolate* isolate, v8::Local<v8::Data> options) {
+  if (options.IsEmpty()) return kj::none;
+  auto values = options.As<v8::PrimitiveArray>();
+  if (values->Length() != 2) return kj::none;
+  auto magic = values->Get(isolate, 0);
+  auto type = values->Get(isolate, 1);
+  if (!magic->IsInt32() || !type->IsInt32() ||
+      magic.As<v8::Int32>()->Value() != MODULE_PROVENANCE_MAGIC) {
+    return kj::none;
