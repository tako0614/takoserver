+
+V8 historically replaces the script containing a dynamic import with its
+ultimate eval origin before invoking the embedder callback. This is necessary
+for relative URL resolution, but it also replaces the generated script's
+host-defined options with those of its origin. Embedders therefore cannot tell
+an import executed by eval() or a Function constructor from one executed by the
+originating module.
+
+Keep the actual referring script through to the callback setup. Continue using
+its ultimate eval origin for resource_name, preserving relative-resolution
+semantics, while reporting the actual script's host-defined options.
+
+diff --git a/src/execution/isolate.cc b/src/execution/isolate.cc
+index 444a6f1b4146720437bcec164e2771ffe1f02091..444a6f1b4146720437bcec164e2771ffe1f02091 100644
+--- a/src/execution/isolate.cc
++++ b/src/execution/isolate.cc
+@@ -7272,7 +7272,8 @@ MaybeDirectHandle<JSPromise> Isolate::RunHostImportModuleDynamicallyCallback(
+     DirectHandle<Script> referrer = maybe_referrer.ToHandleChecked();
+     host_defined_options =
+         direct_handle(referrer->host_defined_options(), this);
+-    resource_name = direct_handle(referrer->name(), this);
++    DirectHandle<Script> referrer_origin(referrer->GetEvalOrigin(), this);
++    resource_name = direct_handle(referrer_origin->name(), this);
+   }
+ 
+   switch (phase) {
+diff --git a/src/runtime/runtime-module.cc b/src/runtime/runtime-module.cc
+index 381cff733c1b0a3b90fda8391392cfe07d3fd5e2..381cff733c1b0a3b90fda8391392cfe07d3fd5e2 100644
+--- a/src/runtime/runtime-module.cc
++++ b/src/runtime/runtime-module.cc
+@@ -23,7 +23,7 @@ RUNTIME_FUNCTION(Runtime_DynamicImportCall) {
+   }
+ 
+   DirectHandle<Script> referrer_script(
+-      Cast<Script>(function->shared()->script())->GetEvalOrigin(), isolate);
++      Cast<Script>(function->shared()->script()), isolate);
+   RETURN_RESULT_OR_FAILURE(
+       isolate, isolate->RunHostImportModuleDynamicallyCallback(
+                    referrer_script, specifier, phase, import_options));
