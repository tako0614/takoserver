index 0000000000000000000000000000000000000000..82e898834c409c38a209f56cc3051642b5bada5d
--- /dev/null
+++ b/src/workerd/tests/closed-module-graph-test.wd-test
@@ -0,0 +1,92 @@
+using Workerd = import "/workerd/workerd.capnp";
+
+# The first two definitions deliberately use the same logical name. Their
+# identities differ only by provenance; rejecting this configuration or
+# aliasing either definition to the other is a policy bug.
+const closedModules :List(Workerd.Worker.Module) = [
+  (name = "entry.js", esModule = embed "closed-module-graph-host.js", role = hostPrivate),
+  (name = "entry.js", esModule = embed "closed-module-graph-app.js"),
+
+  # HOST_PRIVATE -> HOST_PRIVATE -> exact APPLICATION main.
+  (name = "host-private.js", role = hostPrivate,
+   esModule = "import * as applicationMain from './entry.js';\nconst dynamicApplicationMain = import('./entry.js');\nexport * from './entry.js';\nexport const hostPrivateBridge = {\n  async test() {\n    if (await dynamicApplicationMain !== applicationMain) {\n      throw new Error('host bridge did not preserve application-main namespace identity');\n    }\n    if (typeof applicationMain.applicationModuleIdentity?.test !== 'function') {\n      throw new Error('host bridge did not resolve the configured application main');\n    }\n  },\n};\n"),
+
+  # CommonJS provenance uses two distinct definitions with one spelling.
+  (name = "host-cjs.cjs", role = hostPrivate,
+   commonJsModule = "module.exports = require('./shared-cjs-dep.cjs')"),
+  (name = "shared-cjs-dep.cjs", role = hostPrivate,
+   commonJsModule = "module.exports = { marker: 'host-private-cjs' }"),
+  (name = "shared-cjs-dep.cjs",
+   commonJsModule = "module.exports = { marker: 'application-cjs' }"),
+  (name = "app-cjs.cjs",
+   commonJsModule = "module.exports = require('./shared-cjs-dep.cjs')"),
+
+  # Declared application graph and non-JavaScript media.
+  (name = "declared.js", esModule = "export const marker = 'declared-application';"),
+  (name = "text.txt", text = "declared text"),
+  (name = "data.bin", data = "declared data"),
+  (name = "module.wasm", wasm = embed "test.wasm"),
+  (name = "tla.js", esModule = "await Promise.resolve(); export const value = 42;"),
+
+  # Cycles and live bindings.
+  (name = "cycle-a.js", esModule = "import { readA } from './cycle-b.js';\nexport let value = 1;\nexport const readThroughB = () => readA();\nexport const increment = () => ++value;\n"),
+  (name = "cycle-b.js", esModule = "import { value } from './cycle-a.js';\nexport const readA = () => value;\n"),
+
+  # This graph must fail with the native TDZ ReferenceError, not be rewritten.
+  (name = "tdz-a.js", esModule = "import { readA } from './tdz-b.js';\nexport const observed = readA();\nexport let value = 1;\n"),
+  (name = "tdz-b.js", esModule = "import { value } from './tdz-a.js';\nexport const readA = () => value;\n"),
+
+  # Explicit declarations win even when their spellings resemble runtime or
+  # previously-generated host modules. There is no reserved tenant prefix.
+  (name = "cloudflare:sockets", esModule = "export default 'tenant-cloudflare';"),
+  (name = "node:process", esModule = "export default 'tenant-node';"),
+  (name = "workerd:runtime", esModule = "export default 'tenant-workerd';"),
+  (name = "node-internal:public_process", esModule = "export default 'tenant-internal-looking';"),
+  (name = "__takoserver_host_entry__.js", esModule = "export default 'tenant-old-generated';"),
+
+  # Dynamically loading these declared wrappers exercises their static import
+  # and re-export resolution without making worker startup itself fail.
+  (name = "bad-static-relative.js", esModule = "import './missing.js';"),
+  (name = "bad-static-cloudflare.js", esModule = "import 'cloudflare:workers';"),
+  (name = "bad-static-node.js", esModule = "import 'node:assert';"),
+  (name = "bad-static-workerd.js", esModule = "import 'workerd:missing';"),
+  (name = "bad-static-host.js", esModule = "import './host-private.js';"),
+  (name = "bad-reexport-relative.js", esModule = "export * from './missing.js';"),
+  (name = "bad-reexport-cloudflare.js", esModule = "export * from 'cloudflare:workers';"),
+  (name = "bad-reexport-node.js", esModule = "export * from 'node:assert';"),
+  (name = "bad-reexport-workerd.js", esModule = "export * from 'workerd:missing';"),
+  (name = "bad-reexport-host.js", esModule = "export * from './host-private.js';"),
+
+  # CommonJS require() must use the same application-only policy.
+  (name = "bad-require-relative.cjs", commonJsModule = "require('./missing.cjs')"),
+  (name = "bad-require-cloudflare.cjs", commonJsModule = "require('cloudflare:workers')"),
+  (name = "bad-require-node.cjs", commonJsModule = "require('node:assert')"),
+  (name = "bad-require-workerd.cjs", commonJsModule = "require('workerd:missing')"),
+  (name = "bad-require-host.cjs", commonJsModule = "require('./host-private.js')"),
+];
+
+const legacyWorker :Workerd.Worker = (
+  modules = .closedModules,
+  compatibilityFlags = ["nodejs_compat_v2", "experimental", "allow_eval_during_startup"],
+  modulePolicy = (applicationMain = "entry.js"),
+  bindings = [(name = "EXPECT_IMPORT_META_MAIN", json = "false")],
+);
+
+const newRegistryWorker :Workerd.Worker = (
+  modules = .closedModules,
+  compatibilityFlags = [
+    "nodejs_compat_v2",
+    "new_module_registry",
+    "experimental",
+    "allow_eval_during_startup",
+  ],
+  modulePolicy = (applicationMain = "entry.js"),
+  bindings = [(name = "EXPECT_IMPORT_META_MAIN", json = "true")],
+);
+
+const unitTests :Workerd.Config = (
+  services = [
+    (name = "closed-module-graph-legacy", worker = .legacyWorker),
+    (name = "closed-module-graph-new", worker = .newRegistryWorker),
+  ],
+);
