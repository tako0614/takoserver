+// Copyright (c) 2026 Cloudflare, Inc.
+// Licensed under the Apache 2.0 license found in the LICENSE file or at:
+//     https://opensource.org/licenses/Apache-2.0
+
+import * as declaredStatic from './declared.js';
+import * as textStatic from './text.txt';
+import * as dataStatic from './data.bin';
+import * as wasmStatic from './module.wasm';
+import * as tlaStatic from './tla.js';
+import { readThroughB, increment } from './cycle-a.js';
+import cloudflareShadow from 'cloudflare:sockets';
+import nodeProcessShadow from 'node:process';
+import workerdShadow from 'workerd:runtime';
+import internalLookingShadow from 'node-internal:public_process';
+import oldGeneratedShadow from '__takoserver_host_entry__.js';
+
+function assert(condition, message) {
+  if (!condition) throw new Error(message);
+}
+
+function capture(promise) {
+  return Promise.resolve(promise).then(
+    (value) => ({ value }),
+    (error) => ({ error })
+  );
+}
+
+function isModuleNotFound(error) {
+  return (
+    error instanceof Error &&
+    /^(No such module|Module not found)/.test(error.message)
+  );
+}
+
+async function expectModuleNotFound(promise, label) {
+  const result = await capture(promise);
+  assert(result.error, `${label}: unexpectedly resolved`);
+  assert(
+    isModuleNotFound(result.error),
+    `${label}: unexpected error ${result.error?.stack ?? result.error}`
+  );
+}
+
+async function expectCapturedModuleNotFound(resultPromise, label) {
+  const result = await resultPromise;
+  assert(result.error, `${label}: unexpectedly resolved`);
+  assert(
+    isModuleNotFound(result.error),
+    `${label}: unexpected error ${result.error?.stack ?? result.error}`
+  );
+}
+
+const missingSpecifiers = [
+  './missing.js',
+  'cloudflare:workers',
+  'node:assert',
+  'workerd:missing',
+  './host-private.js',
+];
+
+// eval(), Function(), new Function(), and the AsyncFunction constructor are
+// only permitted during startup. Capture both positive and negative outcomes
+// now, while still executing in actual V8 startup evaluation.
+const AsyncFunction = Object.getPrototypeOf(async function () {}).constructor;
+const startupGeneratedImports = {
+  eval: missingSpecifiers.map((specifier) =>
+    capture(eval(`import(${JSON.stringify(specifier)})`))
+  ),
+  function: missingSpecifiers.map((specifier) =>
+    capture(Function(`return import(${JSON.stringify(specifier)})`)())
+  ),
+  newFunction: missingSpecifiers.map((specifier) =>
+    capture(new Function(`return import(${JSON.stringify(specifier)})`)())
+  ),
+  asyncFunction: missingSpecifiers.map((specifier) =>
+    capture(new AsyncFunction(`return import(${JSON.stringify(specifier)})`)())
+  ),
+};
+
+const declaredGeneratedImports = {
+  eval: capture(eval('import("cloudflare:sockets")')),
+  function: capture(Function('return import("node:process")')()),
+  newFunction: capture(new Function('return import("workerd:runtime")')()),
+  asyncFunction: capture(
+    new AsyncFunction('return import("node-internal:public_process")')()
+  ),
+};
+
+let lexicalValue = 40;
+const directEvalLexicalResult = eval('lexicalValue + 2');
+
+export const applicationModuleIdentity = {
+  url: import.meta.url,
+  main: import.meta.main,
+  async test(_controller, env) {
+    if (env.EXPECT_IMPORT_META_MAIN) {
+      assert(
+        typeof import.meta.url === 'string',
+        'application import.meta.url missing'
+      );
+      assert(
+        import.meta.url.endsWith('/entry.js') || import.meta.url === 'entry.js',
+        `unexpected application import.meta.url: ${import.meta.url}`
+      );
+      assert(
+        import.meta.main === true,
+        'configured application main was not marked main'
+      );
+    } else {
+      assert(
+        import.meta.url === undefined,
+        'legacy import.meta.url semantics changed'
+      );
+      assert(
+        import.meta.main === undefined,
+        'legacy import.meta.main semantics changed'
+      );
+    }
+  },
+};
+
+export const declaredMediaAndNamespaceIdentity = {
+  async test() {
+    assert(
+      declaredStatic.marker === 'declared-application',
+      'declared JS did not load'
+    );
+    assert(
+      (await import('./declared.js')) === declaredStatic,
+      'static/dynamic JS namespace identity diverged'
+    );
+    assert(
+      textStatic.default === 'declared text',
+      'declared text did not load'
+    );
+    assert(
+      (await import('./text.txt')) === textStatic,
+      'static/dynamic text namespace identity diverged'
+    );
+    assert(
+      new TextDecoder().decode(dataStatic.default) === 'declared data',
+      'declared data did not load'
+    );
+    assert(
+      (await import('./data.bin')) === dataStatic,
+      'static/dynamic data namespace identity diverged'
+    );
+    assert(
+      wasmStatic.default instanceof WebAssembly.Module,
+      'declared Wasm did not load'
+    );
+    assert(
+      (await import('./module.wasm')) === wasmStatic,
+      'static/dynamic Wasm namespace identity diverged'
+    );
+    await WebAssembly.instantiate(wasmStatic.default, {});
+    assert(
+      tlaStatic.value === 42,
+      'declared top-level-await module did not settle'
+    );
+    assert(
+      (await import('./tla.js')) === tlaStatic,
+      'top-level-await namespace identity diverged'
+    );
+  },
+};
+
+export const cyclesLiveBindingsAndTdz = {
+  async test() {
+    assert(
+      readThroughB() === 1,
+      'cycle did not expose the initialized live binding'
+    );
+    increment();
+    assert(readThroughB() === 2, 'cycle did not preserve a live binding');
+
+    const result = await capture(import('./tdz-a.js'));
+    assert(
+      result.error instanceof ReferenceError,
+      `TDZ graph did not produce ReferenceError: ${result.error?.stack ?? result.error}`
+    );
+  },
+};
+
+export const declaredBuiltinLookingNames = {
+  async test() {
+    assert(
+      cloudflareShadow === 'tenant-cloudflare',
+      'cloudflare: declaration lost to builtin'
+    );
+    assert(
+      nodeProcessShadow === 'tenant-node',
+      'node:process declaration lost to shortcut'
+    );
+    assert(
+      workerdShadow === 'tenant-workerd',
+      'workerd: declaration lost to builtin'
+    );
+    assert(
+      internalLookingShadow === 'tenant-internal-looking',
+      'internal-looking application name was reserved'
+    );
+    assert(
+      oldGeneratedShadow === 'tenant-old-generated',
+      'old generated module spelling was reserved'
+    );
+    assert(
+      (await import('cloudflare:sockets')).default === cloudflareShadow,
+      'dynamic cloudflare: declaration did not retain tenant identity'
+    );
+    assert(
+      (await import('node:process')).default === nodeProcessShadow,
+      'dynamic node:process declaration did not retain tenant identity'
+    );
+    assert(
+      (await import('workerd:runtime')).default === workerdShadow,
+      'dynamic workerd: declaration did not retain tenant identity'
+    );
+  },
+};
+
+export const undeclaredDynamicImports = {
+  async test() {
+    for (const specifier of missingSpecifiers) {
+      await expectModuleNotFound(
+        import(specifier),
+        `dynamic import ${specifier}`
+      );
+    }
+  },
+};
+
+export const undeclaredStaticImportsAndReexports = {
+  async test() {
+    const wrappers = [
+      './bad-static-relative.js',
+      './bad-static-cloudflare.js',
+      './bad-static-node.js',
+      './bad-static-workerd.js',
+      './bad-static-host.js',
+      './bad-reexport-relative.js',
+      './bad-reexport-cloudflare.js',
+      './bad-reexport-node.js',
+      './bad-reexport-workerd.js',
+      './bad-reexport-host.js',
+    ];
+    for (const wrapper of wrappers) {
+      await expectModuleNotFound(
+        import(wrapper),
+        `static/re-export wrapper ${wrapper}`
+      );
+    }
+  },
+};
+
+export const startupEvalAndFunctionResolution = {
+  async test() {
+    assert(
+      directEvalLexicalResult === 42,
+      'direct eval lexical semantics changed'
+    );
+    for (const [kind, results] of Object.entries(startupGeneratedImports)) {
+      for (let i = 0; i < missingSpecifiers.length; ++i) {
+        await expectCapturedModuleNotFound(
+          results[i],
+          `${kind} import ${missingSpecifiers[i]}`
+        );
+      }
+    }
+
+    const positive = await Promise.all(Object.values(declaredGeneratedImports));
+    for (const [index, result] of positive.entries()) {
+      assert(
+        !result.error,
+        `generated declared import ${index} failed: ${result.error?.stack}`
+      );
+    }
+    assert(
+      positive[0].value.default === 'tenant-cloudflare',
+      'eval bypassed application identity'
+    );
+    assert(
+      positive[1].value.default === 'tenant-node',
+      'Function bypassed application identity'
+    );
+    assert(
+      positive[2].value.default === 'tenant-workerd',
+      'new Function bypassed application identity'
+    );
+    assert(
+      positive[3].value.default === 'tenant-internal-looking',
+      'AsyncFunction bypassed application identity'
+    );
+  },
+};
+
+export const commonJsResolution = {
+  async test() {
+    const declared = await import('./app-cjs.cjs');
+    let value = declared;
+    for (let i = 0; i < 3 && value?.marker === undefined; ++i)
+      value = value?.default;
+    assert(
+      value?.marker === 'application-cjs',
+      `application CommonJS resolved unexpected marker: ${value?.marker}`
+    );
+
+    const wrappers = [
+      './bad-require-relative.cjs',
+      './bad-require-cloudflare.cjs',
+      './bad-require-node.cjs',
+      './bad-require-workerd.cjs',
+      './bad-require-host.cjs',
+    ];
+    for (const wrapper of wrappers) {
+      await expectModuleNotFound(
+        import(wrapper),
+        `CommonJS require wrapper ${wrapper}`
+      );
+    }
+  },
+};
+
+export const builtinShortcutsAreClosed = {
+  test() {
+    assert(
+      globalThis.process &&
+        typeof globalThis.process.getBuiltinModule === 'function',
+      'runtime process global is unavailable'
+    );
+    assert(
+      globalThis.process.getBuiltinModule('node:assert') === undefined,
+      'process.getBuiltinModule escaped the declared application graph'
+    );
+    assert(
+      globalThis.process.getBuiltinModule('cloudflare:sockets') === undefined,
+      'getBuiltinModule observed a builtin or tenant shadow outside import resolution'
+    );
+  },
+};
