+// Copyright (c) 2026 Cloudflare, Inc.
+// Licensed under the Apache 2.0 license found in the LICENSE file or at:
+//     https://opensource.org/licenses/Apache-2.0
+
+import * as applicationMain from './entry.js';
+import * as hostHelper from './host-private.js';
+import hostCjs from './host-cjs.cjs';
+
+export * from './host-private.js';
+
+function assert(condition, message) {
+  if (!condition) throw new Error(message);
+}
+
+function capture(promise) {
+  return Promise.resolve(promise).then(
+    (value) => ({ value }),
+    (error) => ({ error })
+  );
+}
+
+function isModuleNotFound(error) {
+  return (
+    error instanceof Error &&
+    /^(No such module|Module not found)/.test(error.message)
+  );
+}
+
+// Host-authored dynamic import retains HOST_PRIVATE provenance. Generated
+// scripts deliberately do not: V8 gives eval/constructor scripts no policy
+// metadata, so they must default to APPLICATION rather than inherit privilege.
+const hostDynamicHelper = capture(import('./host-private.js'));
+const hostDynamicApplicationMain = capture(import('./entry.js'));
+const hostEvalPrivate = capture(eval('import("./host-private.js")'));
+const hostFunctionPrivate = capture(
+  Function('return import("./host-private.js")')()
+);
+const hostNewFunctionPrivate = capture(
+  new Function('return import("./host-private.js")')()
+);
+const AsyncFunction = Object.getPrototypeOf(async function () {}).constructor;
+const hostAsyncFunctionPrivate = capture(
+  new AsyncFunction('return import("./host-private.js")')()
+);
+const hostEvalApplication = capture(eval('import("cloudflare:sockets")'));
+
+export const hostModuleIdentity = {
+  async test(_controller, env) {
+    assert(
+      applicationMain !== hostHelper,
+      'application main and host helper unexpectedly share a namespace'
+    );
+    assert(
+      import.meta.url === applicationMain.applicationModuleIdentity.url,
+      'same-spelling host/application identities lost their logical URL'
+    );
+    if (env.EXPECT_IMPORT_META_MAIN) {
+      assert(
+        import.meta.main === true,
+        'configured host entrypoint was not marked main'
+      );
+    } else {
+      assert(
+        import.meta.main === undefined,
+        'legacy host import.meta.main semantics changed'
+      );
+    }
+  },
+};
+
+export const hostDynamicResolution = {
+  async test() {
+    const helper = await hostDynamicHelper;
+    assert(
+      !helper.error,
+      `host dynamic private import failed: ${helper.error?.stack}`
+    );
+    assert(
+      helper.value === hostHelper,
+      'host dynamic namespace identity diverged'
+    );
+
+    const app = await hostDynamicApplicationMain;
+    assert(
+      !app.error,
+      `host dynamic application-main bridge failed: ${app.error?.stack}`
+    );
+    assert(
+      app.value === applicationMain,
+      'host application-main namespace identity diverged'
+    );
+  },
+};
+
+export const generatedHostCodeDefaultsToApplication = {
+  async test() {
+    for (const [kind, promise] of [
+      ['eval', hostEvalPrivate],
+      ['Function', hostFunctionPrivate],
+      ['new Function', hostNewFunctionPrivate],
+      ['AsyncFunction', hostAsyncFunctionPrivate],
+    ]) {
+      const result = await promise;
+      assert(result.error, `${kind} unexpectedly inherited host privilege`);
+      assert(
+        isModuleNotFound(result.error),
+        `${kind} produced unexpected error: ${result.error?.stack ?? result.error}`
+      );
+    }
+
+    const application = await hostEvalApplication;
+    assert(
+      !application.error,
+      `host eval did not default to application provenance: ${application.error?.stack}`
+    );
+    assert(
+      application.value.default === 'tenant-cloudflare',
+      'host eval resolved something other than the declared application module'
+    );
+  },
+};
+
+export const hostCommonJsResolution = {
+  test() {
+    let value = hostCjs;
+    for (let i = 0; i < 3 && value?.marker === undefined; ++i)
+      value = value?.default;
+    assert(
+      value?.marker === 'host-private-cjs',
+      `host CommonJS resolved unexpected marker: ${value?.marker}`
+    );
+  },
+};
diff --git a/src/workerd/tests/closed-module-graph-test.wd-test b/src/workerd/tests/closed-module-graph-test.wd-test
