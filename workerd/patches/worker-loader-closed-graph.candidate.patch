 constexpr size_t MAX_DYNAMIC_WORKER_ENV_SIZE = 1 * 1024 * 1024;
 
+Worker::Script::ModuleRole parseModuleRole(
+    const jsg::Optional<kj::String>& maybeRole, kj::StringPtr fieldName) {
+  KJ_IF_SOME(role, maybeRole) {
+    if (role == "application"_kj) {
+      return Worker::Script::ModuleRole::APPLICATION;
+    }
+    if (role == "hostPrivate"_kj) {
+      return Worker::Script::ModuleRole::HOST_PRIVATE;
+    }
+    JSG_FAIL_REQUIRE(TypeError, fieldName,
+        " must be either 'application' or 'hostPrivate'. Got: ", role);
+  }
+  return Worker::Script::ModuleRole::APPLICATION;
+}
+
 }  // namespace
 
