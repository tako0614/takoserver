@@ -330,5 +347,71 @@ Worker::Script::Source WorkerLoader::extractSource(jsg::Lock& js, WorkerCode& co
   };
 
+  auto mainModuleRole = parseModuleRole(code.mainModuleRole, "mainModuleRole"_kj);
+
+  kj::Maybe<Worker::Script::ModulesSource::ModulePolicy> modulePolicy;
+  KJ_IF_SOME(policy, code.modulePolicy) {
+    JSG_REQUIRE(policy.applicationMain.size() > 0, TypeError,
+        "modulePolicy.applicationMain must name an application module.");
+    modulePolicy = Worker::Script::ModulesSource::ModulePolicy{
+      .applicationMain = policy.applicationMain,
+    };
+  }
+
+  JSG_REQUIRE(mainModuleRole != Worker::Script::ModuleRole::HOST_PRIVATE ||
+          modulePolicy != kj::none,
+      TypeError, "mainModuleRole is hostPrivate but modulePolicy is not configured.");
+
+  // Match the static config path's namespace and policy validation. A dynamic
+  // modules dictionary cannot spell the same property twice, but retaining the
+  // namespace-local duplicate check keeps the Worker::Script invariant explicit.
+  for (uint i = 0; i < modules.size(); ++i) {
+    if (modules[i].role == Worker::Script::ModuleRole::HOST_PRIVATE &&
+        modulePolicy == kj::none) {
+      JSG_FAIL_REQUIRE(TypeError, "Module \"", modules[i].name,
+          "\" is hostPrivate but modulePolicy is not configured.");
+    }
+    for (uint j = 0; j < i; ++j) {
+      if (modules[i].role == modules[j].role && modules[i].name == modules[j].name) {
+        JSG_FAIL_REQUIRE(TypeError, "Module \"", modules[i].name,
+            "\" is duplicated within the ",
+            modules[i].role == Worker::Script::ModuleRole::APPLICATION ? "application"
+                                                                        : "host-private",
+            " namespace.");
+      }
+    }
+  }
+
+  KJ_IF_SOME(policy, modulePolicy) {
+    bool foundApplicationMain = false;
+    for (auto& module: modules) {
+      if (module.role == Worker::Script::ModuleRole::APPLICATION &&
+          module.name == policy.applicationMain) {
+        foundApplicationMain = true;
+        break;
+      }
+    }
+    JSG_REQUIRE(foundApplicationMain, TypeError, "modulePolicy.applicationMain \"",
+        policy.applicationMain, "\" does not name a declared application module.");
+  }
+
+  bool foundMainModule = false;
+  bool foundMainModuleInOtherRole = false;
+  for (auto& module: modules) {
+    if (module.name == code.mainModule) {
+      if (module.role == mainModuleRole) {
+        foundMainModule = true;
+      } else {
+        foundMainModuleInOtherRole = true;
+      }
+    }
+  }
+  auto mainRoleName = mainModuleRole == Worker::Script::ModuleRole::APPLICATION ? "application"_kj
+                                                                                : "hostPrivate"_kj;
+  JSG_REQUIRE(!foundMainModuleInOtherRole || foundMainModule, TypeError, "mainModuleRole \"",
+      mainRoleName, "\" conflicts with Module.role for mainModule \"", code.mainModule, "\".");
+  JSG_REQUIRE(foundMainModule, TypeError, "mainModule \"", code.mainModule,
+      "\" does not name a declared ", mainRoleName, " module.");
+
   bool isPython = code.mainModule.endsWith(".py"_kj);
   // Disallow Python modules when the main module is a JS module. Also tally up the
   // total size of all module bodies so we can enforce the worker code size limit.
