diff --git a/src/workerd/api/tests/worker-loader-test.js b/src/workerd/api/tests/worker-loader-test.js
--- a/src/workerd/api/tests/worker-loader-test.js
+++ b/src/workerd/api/tests/worker-loader-test.js
@@ -1454,3 +1454,192 @@ export let minimalPythonPackage = {
     }
   },
 };
+
+export let closedGraphModulePolicy = {
+  async test(ctrl, env, ctx) {
+    const legacyWorker = env.loader.load({
+      compatibilityDate: '2026-01-01',
+      mainModule: 'legacy-host.js',
+      mainModuleRole: 'hostPrivate',
+      modulePolicy: { applicationMain: 'legacy-app.js' },
+      modules: {
+        'legacy-app.js': {
+          role: 'application',
+          js: `export const value = 'legacy-application';`,
+        },
+        'legacy-host.js': {
+          role: 'hostPrivate',
+          js: `
+            import { value } from './legacy-app.js';
+            export default { read() { return value; } };
+          `,
+        },
+      },
+    });
+    assert.strictEqual(await legacyWorker.getEntrypoint().read(), 'legacy-application');
+
+    const worker = env.loader.load({
+      compatibilityDate: '2026-01-01',
+      compatibilityFlags: ['new_module_registry'],
+      allowExperimental: true,
+      mainModule: 'host.js',
+      mainModuleRole: 'hostPrivate',
+      modulePolicy: { applicationMain: 'app.js' },
+      modules: {
+        'app.js': {
+          role: 'application',
+          js: `
+            export const applicationValue = 'application';
+            export async function rejectsHostPrivateImport() {
+              try {
+                await import('./private.js');
+                return false;
+              } catch (error) {
+                return /^(No such module|Module not found)/.test(error.message);
+              }
+            }
+          `,
+        },
+        'host.js': {
+          role: 'hostPrivate',
+          js: `
+            import {
+              applicationValue,
+              rejectsHostPrivateImport,
+            } from './app.js';
+            import { privateValue } from './private.js';
+
+            export default {
+              async inspect() {
+                return {
+                  applicationValue,
+                  privateValue,
+                  applicationRejectedPrivate: await rejectsHostPrivateImport(),
+                };
+              },
+            };
+          `,
+        },
+        'private.js': {
+          role: 'hostPrivate',
+          js: `export const privateValue = 'host-private';`,
+        },
+      },
+    });
+
+    assert.deepStrictEqual(await worker.getEntrypoint().inspect(), {
+      applicationValue: 'application',
+      privateValue: 'host-private',
+      applicationRejectedPrivate: true,
+    });
+  },
+};
+
+export let closedGraphModulePolicyValidation = {
+  test(ctrl, env, ctx) {
+    const base = {
+      compatibilityDate: '2026-01-01',
+      mainModule: 'app.js',
+      modules: {
+        'app.js': `export default {};`,
+      },
+    };
+
+    assert.throws(
+      () =>
+        env.loader.load({
+          ...base,
+          modules: {
+            ...base.modules,
+            'private.js': {
+              role: 'hostPrivate',
+              js: `export const value = 'private';`,
+            },
+          },
+        }),
+      {
+        name: 'TypeError',
+        message:
+          'Module "private.js" is hostPrivate but modulePolicy is not configured.',
+      }
+    );
+
+    assert.throws(
+      () =>
+        env.loader.load({
+          ...base,
+          modulePolicy: { applicationMain: '' },
+        }),
+      {
+        name: 'TypeError',
+        message: 'modulePolicy.applicationMain must name an application module.',
+      }
+    );
+
+    assert.throws(
+      () =>
+        env.loader.load({
+          ...base,
+          modulePolicy: { applicationMain: 'missing.js' },
+        }),
+      {
+        name: 'TypeError',
+        message:
+          'modulePolicy.applicationMain "missing.js" does not name a declared application module.',
+      }
+    );
+
+    assert.throws(
+      () =>
+        env.loader.load({
+          ...base,
+          mainModule: 'host.js',
+          mainModuleRole: 'application',
+          modulePolicy: { applicationMain: 'app.js' },
+          modules: {
+            ...base.modules,
+            'host.js': {
+              role: 'hostPrivate',
+              js: `export default {};`,
+            },
+          },
+        }),
+      {
+        name: 'TypeError',
+        message:
+          'mainModuleRole "application" conflicts with Module.role for mainModule "host.js".',
+      }
+    );
+
+    assert.throws(
+      () =>
+        env.loader.load({
+          ...base,
+          mainModuleRole: 'hostPrivate',
+        }),
+      {
+        name: 'TypeError',
+        message:
+          'mainModuleRole is hostPrivate but modulePolicy is not configured.',
+      }
+    );
+
+    assert.throws(
+      () =>
+        env.loader.load({
+          ...base,
+          modules: {
+            'app.js': {
+              role: 'host-private',
+              js: `export default {};`,
+            },
+          },
+        }),
+      {
+        name: 'TypeError',
+        message:
+          "Module.role must be either 'application' or 'hostPrivate'. Got: host-private",
+      }
+    );
+  },
+};
