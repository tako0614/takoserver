diff --git a/src/workerd/api/tests/worker-loader-test.js b/src/workerd/api/tests/worker-loader-test.js
--- a/src/workerd/api/tests/worker-loader-test.js
+++ b/src/workerd/api/tests/worker-loader-test.js
@@ -1454,3 +1454,180 @@ export let minimalPythonPackage = {
     }
   },
 };
+
+export let closedGraphModulePolicy = {
+  async test(ctrl, env, ctx) {
+    const appOnlyWorker = env.loader.load({
+      compatibilityDate: '2026-01-01',
+      mainModule: 'legacy-app.js',
+      modules: {
+        'legacy-app.js': `
+          export default { read() { return 'legacy-application'; } };
+        `,
+      },
+    });
+    assert.strictEqual(await appOnlyWorker.getEntrypoint().read(), 'legacy-application');
+
+    const registryOptions = [
+      {},
+      {
+        compatibilityFlags: ['new_module_registry'],
+        allowExperimental: true,
+      },
+    ];
+    for (const options of registryOptions) {
+      const worker = env.loader.load({
+        ...options,
+        compatibilityDate: '2026-01-01',
+        mainModule: 'host.js',
+        mainModuleRole: 'hostPrivate',
+        modulePolicy: { applicationMain: 'app.js' },
+        modules: {
+          'app.js': `
+            import { identity } from './shared.js';
+            export const applicationSharedIdentity = identity;
+            export async function rejectsHostPrivateImport() {
+              try {
+                await import('./private.js');
+                return false;
+              } catch (error) {
+                return /^(No such module|Module not found)/.test(error.message);
+              }
+            }
+          `,
+          'shared.js': `export const identity = 'application-shared';`,
+        },
+        hostPrivateModules: {
+          'host.js': `
+            import {
+              applicationSharedIdentity,
+              rejectsHostPrivateImport,
+            } from './app.js';
+            import { identity as hostPrivateSharedIdentity } from './shared.js';
+            import { privateValue } from './private.js';
+
+            export default {
+              async inspect() {
+                return {
+                  applicationSharedIdentity,
+                  hostPrivateSharedIdentity,
+                  privateValue,
+                  applicationRejectedPrivate: await rejectsHostPrivateImport(),
+                };
+              },
+            };
+          `,
+          'shared.js': `export const identity = 'host-private-shared';`,
+          'private.js': `export const privateValue = 'host-private';`,
+        },
+      });
+
+      assert.deepStrictEqual(await worker.getEntrypoint().inspect(), {
+        applicationSharedIdentity: 'application-shared',
+        hostPrivateSharedIdentity: 'host-private-shared',
+        privateValue: 'host-private',
+        applicationRejectedPrivate: true,
+      });
+    }
+  },
+};
+
+export let closedGraphModulePolicyValidation = {
+  test(ctrl, env, ctx) {
+    const base = {
+      compatibilityDate: '2026-01-01',
+      mainModule: 'app.js',
+      modules: {
+        'app.js': `export default {};`,
+      },
+    };
+
+    assert.throws(
+      () =>
+        env.loader.load({
+          ...base,
+          hostPrivateModules: {
+            'private.js': `export const value = 'private';`,
+          },
+        }),
+      {
+        name: 'TypeError',
+        message:
+          'hostPrivateModules requires modulePolicy when it contains modules.',
+      }
+    );
+
+    assert.throws(
+      () =>
+        env.loader.load({
+          ...base,
+          modulePolicy: { applicationMain: '' },
+        }),
+      {
+        name: 'TypeError',
+        message: 'modulePolicy.applicationMain must name an application module.',
+      }
+    );
+
+    assert.throws(
+      () =>
+        env.loader.load({
+          ...base,
+          modulePolicy: { applicationMain: 'private.js' },
+          hostPrivateModules: {
+            'private.js': `export const value = 'private';`,
+          },
+        }),
+      {
+        name: 'TypeError',
+        message:
+          'modulePolicy.applicationMain "private.js" does not name a declared application module.',
+      }
+    );
+
+    assert.throws(
+      () =>
+        env.loader.load({
+          ...base,
+          mainModule: 'host.js',
+          mainModuleRole: 'application',
+          modulePolicy: { applicationMain: 'app.js' },
+          hostPrivateModules: {
+            'host.js': `export default {};`,
+          },
+        }),
+      {
+        name: 'TypeError',
+        message:
+          'mainModuleRole "application" selects modules, but mainModule "host.js" ' +
+          'is only declared in hostPrivateModules.',
+      }
+    );
+
+    assert.throws(
+      () =>
+        env.loader.load({
+          ...base,
+          mainModuleRole: 'hostPrivate',
+        }),
+      {
+        name: 'TypeError',
+        message:
+          'mainModuleRole is hostPrivate but modulePolicy is not configured.',
+      }
+    );
+
+    assert.throws(
+      () =>
+        env.loader.load({
+          ...base,
+          mainModuleRole: 'host-private',
+        }),
+      {
+        name: 'TypeError',
+        message:
+          "mainModuleRole must be either 'application' or 'hostPrivate'. Got: host-private",
+      }
+    );
+  },
+};
