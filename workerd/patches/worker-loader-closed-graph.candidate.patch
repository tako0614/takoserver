+        foundMainModule = true;
+      } else {
+        foundMainModuleInOtherRole = true;
+      }
+    }
+  }
+  auto mainRoleName =
+      mainModuleRole == Worker::Script::ModuleRole::APPLICATION ? "application"_kj
