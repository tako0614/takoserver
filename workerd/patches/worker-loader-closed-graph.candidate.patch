+
+  // The separate dictionaries provide namespace-local identity. In particular,
+  // one logical name may be present once in each role.
+  kj::Vector<Worker::Script::Module> allModules(
+      code.modules.fields.size() + hostPrivateModuleCount);
+  auto appendModules = [&](auto& moduleDict, Worker::Script::ModuleRole role) {
+    auto extractedModules = extractModules(moduleDict, role);
+    for (auto& module: extractedModules) {
