  "fences": {
    "transport": {
      "header": "Takoform-Expected-Generation",
      "applyBodyField": "expectedGeneration",
      "bothPresentRule": "when apply carries the header and the body field they MUST be equal; disagreement is invalid_argument before any fence is evaluated",
      "createRule": "a create is fenced by If-None-Match: *; carrying If-None-Match together with a generation fence is invalid_argument"
    },
    "required": {
      "update": {
        "transport": [
          "header",
          "applyBodyField"
        ],
        "absent": "invalid_argument",
        "stale": "generation_conflict"
      },
