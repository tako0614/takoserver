        "absentResource": "resource_not_found"
      },
      "observe": {
        "transport": [
          "header"
        ],
        "absent": "invalid_argument",
        "stale": "generation_conflict"
      },
      "delete": {
        "transport": [
          "header"
        ],
        "absent": "invalid_argument",
