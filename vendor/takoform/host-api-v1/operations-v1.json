      }
    }
  },
  "identifierGrammars": {
    "operationId": "^op_[A-Za-z0-9][A-Za-z0-9._-]{0,124}$ (the operation schema's pattern, quoted)",
    "uploadId": "^up_[A-Za-z0-9][A-Za-z0-9._-]{0,124}$ (the wire schema's pattern, quoted)",
    "idempotencyKey": "1..255 visible ASCII characters (0x21-0x7E)"
