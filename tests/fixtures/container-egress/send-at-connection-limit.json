{
  "schemaVersion": 1,
  "id": "send-at-connection-limit",
  "description": "An existing connection can send without consuming another slot",
  "coverage": ["connection-limit", "egress-accounting"],
  "initialUsage": {
    "tenant-a": {
      "activeConnections": 4,
      "bandwidthUsedBytes": 0,
      "egressBytes": 10
    },
    "tenant-b": {
      "activeConnections": 3,
      "bandwidthUsedBytes": 700,
      "egressBytes": 9000
    }
  },
  "steps": [
    {
      "policy": {
        "killSwitch": false,
        "tenants": {
          "tenant-a": {
            "outboundInternet": true,
            "maxConnections": 4,
            "bandwidthLimitBytes": 1024
          },
          "tenant-b": {
            "outboundInternet": true,
            "maxConnections": 5,
            "bandwidthLimitBytes": 2048
          }
        }
      },
      "request": {
        "tenantId": "tenant-a",
        "operation": "send",
        "destinationIp": "1.1.1.1",
        "destinationPort": 443,
        "transport": "tcp",
        "bytes": 1
      },
      "expected": {
        "allowed": true,
        "reason": "allowed",
        "billableEgressBytes": 1,
        "usage": {
          "tenant-a": {
            "activeConnections": 4,
            "bandwidthUsedBytes": 1,
            "egressBytes": 11
          },
          "tenant-b": {
            "activeConnections": 3,
            "bandwidthUsedBytes": 700,
            "egressBytes": 9000
          }
        }
      }
    }
  ]
}
