{
  "schemaVersion": 1,
  "id": "invalid-fractional-bytes",
  "description": "Fractional byte counts cannot be admitted or billed",
  "coverage": ["egress-accounting"],
  "initialUsage": {
    "tenant-a": {
      "activeConnections": 1,
      "bandwidthUsedBytes": 7,
      "egressBytes": 900
    },
    "tenant-b": {
      "activeConnections": 3,
      "bandwidthUsedBytes": 700,
      "egressBytes": 9000
    }
  },
  "steps": [
    {
      "policy": {
        "killSwitch": false,
        "tenants": {
          "tenant-a": {
            "outboundInternet": true,
            "maxConnections": 4,
            "bandwidthLimitBytes": 1024
          },
          "tenant-b": {
            "outboundInternet": true,
            "maxConnections": 5,
            "bandwidthLimitBytes": 2048
          }
        }
      },
      "request": {
        "tenantId": "tenant-a",
        "operation": "send",
        "destinationIp": "1.1.1.1",
        "destinationPort": 443,
        "transport": "tcp",
        "bytes": 0.5
      },
      "expected": {
        "allowed": false,
        "reason": "invalid_input",
        "billableEgressBytes": 0,
        "usage": {
          "tenant-a": {
            "activeConnections": 1,
            "bandwidthUsedBytes": 7,
            "egressBytes": 900
          },
          "tenant-b": {
            "activeConnections": 3,
            "bandwidthUsedBytes": 700,
            "egressBytes": 9000
          }
        }
      }
    }
  ]
}
