{
  "schemaVersion": 1,
  "id": "tenant-other-bandwidth-exhausted",
  "description": "Another tenant with an exhausted byte window does not consume this tenant cap",
  "coverage": ["tenant-isolation", "bandwidth-limit", "egress-accounting"],
  "initialUsage": {
    "tenant-a": {
      "activeConnections": 1,
      "bandwidthUsedBytes": 0,
      "egressBytes": 0
    },
    "tenant-b": {
      "activeConnections": 3,
      "bandwidthUsedBytes": 2048,
      "egressBytes": 9000
    }
  },
  "steps": [
    {
      "policy": {
        "killSwitch": false,
        "tenants": {
          "tenant-a": {
            "outboundInternet": true,
            "maxConnections": 4,
            "bandwidthLimitBytes": 1024
          },
          "tenant-b": {
            "outboundInternet": true,
            "maxConnections": 5,
            "bandwidthLimitBytes": 2048
          }
        }
      },
      "request": {
        "tenantId": "tenant-a",
        "operation": "send",
        "destinationIp": "1.1.1.1",
        "destinationPort": 443,
        "transport": "tcp",
        "bytes": 1
      },
      "expected": {
        "allowed": true,
        "reason": "allowed",
        "billableEgressBytes": 1,
        "usage": {
          "tenant-a": {
            "activeConnections": 1,
            "bandwidthUsedBytes": 1,
            "egressBytes": 1
          },
          "tenant-b": {
            "activeConnections": 3,
            "bandwidthUsedBytes": 2048,
            "egressBytes": 9000
          }
        }
      }
    }
  ]
}
