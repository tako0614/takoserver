{
  "schemaVersion": 1,
  "id": "kill-switch-existing-send",
  "description": "The global kill switch immediately refuses traffic on an existing connection",
  "coverage": ["kill-switch", "egress-accounting"],
  "initialUsage": {
    "tenant-a": {
      "activeConnections": 1,
      "bandwidthUsedBytes": 7,
      "egressBytes": 900
    },
    "tenant-b": {
      "activeConnections": 3,
      "bandwidthUsedBytes": 700,
      "egressBytes": 9000
    }
  },
  "steps": [
    {
      "policy": {
        "killSwitch": true,
        "tenants": {
          "tenant-a": {
            "outboundInternet": true,
            "maxConnections": 4,
            "bandwidthLimitBytes": 1024
          },
          "tenant-b": {
            "outboundInternet": true,
            "maxConnections": 5,
            "bandwidthLimitBytes": 2048
          }
        }
      },
      "request": {
        "tenantId": "tenant-a",
        "operation": "send",
        "destinationIp": "1.1.1.1",
        "destinationPort": 443,
        "transport": "tcp",
        "bytes": 5
      },
      "expected": {
        "allowed": false,
        "reason": "kill_switch",
        "billableEgressBytes": 0,
        "usage": {
          "tenant-a": {
            "activeConnections": 1,
            "bandwidthUsedBytes": 7,
            "egressBytes": 900
          },
          "tenant-b": {
            "activeConnections": 3,
            "bandwidthUsedBytes": 700,
            "egressBytes": 9000
          }
        }
      }
    }
  ]
}
