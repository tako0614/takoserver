{
  "schemaVersion": 1,
  "id": "tenant-first-usage",
  "description": "A configured tenant with no counters begins from a zero snapshot",
  "coverage": ["tenant-isolation"],
  "initialUsage": {
    "tenant-b": {
      "activeConnections": 3,
      "bandwidthUsedBytes": 700,
      "egressBytes": 9000
    }
  },
  "steps": [
    {
      "policy": {
        "killSwitch": false,
        "tenants": {
          "tenant-a": {
            "outboundInternet": true,
            "maxConnections": 4,
            "bandwidthLimitBytes": 1024
          },
          "tenant-b": {
            "outboundInternet": true,
            "maxConnections": 5,
            "bandwidthLimitBytes": 2048
          }
        }
      },
      "request": {
        "tenantId": "tenant-a",
        "operation": "open",
        "destinationIp": "1.1.1.1",
        "destinationPort": 443,
        "transport": "tcp",
        "bytes": 0
      },
      "expected": {
        "allowed": true,
        "reason": "allowed",
        "billableEgressBytes": 0,
        "usage": {
          "tenant-a": {
            "activeConnections": 1,
            "bandwidthUsedBytes": 0,
            "egressBytes": 0
          },
          "tenant-b": {
            "activeConnections": 3,
            "bandwidthUsedBytes": 700,
            "egressBytes": 9000
          }
        }
      }
    }
  ]
}
