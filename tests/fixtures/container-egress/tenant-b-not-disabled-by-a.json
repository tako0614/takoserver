{
  "schemaVersion": 1,
  "id": "tenant-b-not-disabled-by-a",
  "description": "Disabling tenant A outbound Internet leaves tenant B admissible",
  "coverage": ["tenant-isolation", "outbound-disabled"],
  "initialUsage": {
    "tenant-a": {
      "activeConnections": 0,
      "bandwidthUsedBytes": 0,
      "egressBytes": 0
    },
    "tenant-b": {
      "activeConnections": 3,
      "bandwidthUsedBytes": 700,
      "egressBytes": 9000
    }
  },
  "steps": [
    {
      "policy": {
        "killSwitch": false,
        "tenants": {
          "tenant-a": {
            "outboundInternet": false,
            "maxConnections": 4,
            "bandwidthLimitBytes": 1024
          },
          "tenant-b": {
            "outboundInternet": true,
            "maxConnections": 5,
            "bandwidthLimitBytes": 2048
          }
        }
      },
      "request": {
        "tenantId": "tenant-b",
        "operation": "open",
        "destinationIp": "1.1.1.1",
        "destinationPort": 443,
        "transport": "tcp",
        "bytes": 0
      },
      "expected": {
        "allowed": true,
        "reason": "allowed",
        "billableEgressBytes": 0,
        "usage": {
          "tenant-a": {
            "activeConnections": 0,
            "bandwidthUsedBytes": 0,
            "egressBytes": 0
          },
          "tenant-b": {
            "activeConnections": 4,
            "bandwidthUsedBytes": 700,
            "egressBytes": 9000
          }
        }
      }
    }
  ]
}
