{
  "schemaVersion": 1,
  "id": "tcp-25-v4",
  "description": "TCP port 25 is refused even for a public address",
  "coverage": ["tcp-25"],
  "initialUsage": {
    "tenant-a": {
      "activeConnections": 0,
      "bandwidthUsedBytes": 0,
      "egressBytes": 0
    },
    "tenant-b": {
      "activeConnections": 3,
      "bandwidthUsedBytes": 700,
      "egressBytes": 9000
    }
  },
  "steps": [
    {
      "policy": {
        "killSwitch": false,
        "tenants": {
          "tenant-a": {
            "outboundInternet": true,
            "maxConnections": 4,
            "bandwidthLimitBytes": 1024
          },
          "tenant-b": {
            "outboundInternet": true,
            "maxConnections": 5,
            "bandwidthLimitBytes": 2048
          }
        }
      },
      "request": {
        "tenantId": "tenant-a",
        "operation": "open",
        "destinationIp": "8.8.8.8",
        "destinationPort": 25,
        "transport": "tcp",
        "bytes": 0
      },
      "expected": {
        "allowed": false,
        "reason": "blocked_tcp_port",
        "billableEgressBytes": 0,
        "usage": {
          "tenant-a": {
            "activeConnections": 0,
            "bandwidthUsedBytes": 0,
            "egressBytes": 0
          },
          "tenant-b": {
            "activeConnections": 3,
            "bandwidthUsedBytes": 700,
            "egressBytes": 9000
          }
        }
      }
    }
  ]
}
