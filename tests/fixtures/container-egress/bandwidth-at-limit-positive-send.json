{
  "schemaVersion": 1,
  "id": "bandwidth-at-limit-positive-send",
  "description": "No positive bytes fit when the window is exhausted",
  "coverage": ["bandwidth-limit"],
  "initialUsage": {
    "tenant-a": {
      "activeConnections": 1,
      "bandwidthUsedBytes": 1024,
      "egressBytes": 4000
    },
    "tenant-b": {
      "activeConnections": 3,
      "bandwidthUsedBytes": 700,
      "egressBytes": 9000
    }
  },
  "steps": [
    {
      "policy": {
        "killSwitch": false,
        "tenants": {
          "tenant-a": {
            "outboundInternet": true,
            "maxConnections": 4,
            "bandwidthLimitBytes": 1024
          },
          "tenant-b": {
            "outboundInternet": true,
            "maxConnections": 5,
            "bandwidthLimitBytes": 2048
          }
        }
      },
      "request": {
        "tenantId": "tenant-a",
        "operation": "send",
        "destinationIp": "1.1.1.1",
        "destinationPort": 443,
        "transport": "tcp",
        "bytes": 1
      },
      "expected": {
        "allowed": false,
        "reason": "bandwidth_limit",
        "billableEgressBytes": 0,
        "usage": {
          "tenant-a": {
            "activeConnections": 1,
            "bandwidthUsedBytes": 1024,
            "egressBytes": 4000
          },
          "tenant-b": {
            "activeConnections": 3,
            "bandwidthUsedBytes": 700,
            "egressBytes": 9000
          }
        }
      }
    }
  ]
}
