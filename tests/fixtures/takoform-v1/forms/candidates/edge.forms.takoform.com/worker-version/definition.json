          "bundle": {
            "additionalProperties": false,
            "description": "Static Asset Bundle whose exact manifest inventory this version serves.",
            "properties": {
              "apiVersion": {
                "const": "edge.forms.takoform.com",
                "type": "string"
              },
              "kind": {
                "const": "StaticAssetBundle",
                "type": "string"
              },
