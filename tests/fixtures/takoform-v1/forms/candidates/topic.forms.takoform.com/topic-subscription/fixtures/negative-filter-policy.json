{
  "deadLetter": {
    "apiVersion": "queue.forms.takoform.com",
    "kind": "PullQueue",
    "name": "dead-letters"
  },
  "filterPolicy": {
    "1 invalid key": [
      "value"
    ]
  },
  "maxRetries": 3,
  "retryDelaySeconds": 60,
  "target": {
    "apiVersion": "queue.forms.takoform.com",
    "kind": "PullQueue",
    "name": "events"
  },
  "topic": {
    "apiVersion": "topic.forms.takoform.com",
    "kind": "Topic",
    "name": "topic"
  }
}
