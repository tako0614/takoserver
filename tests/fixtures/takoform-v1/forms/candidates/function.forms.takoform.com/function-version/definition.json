  "title": "Function Version",
  "description": "Immutable content-addressed executable snapshot of one Function: artifact manifest, handler, environment declarations, sealed slots, and invocation bounds.",
  "role": "revision",
  "requiresHostApi": "forms.takoform.com/v1",
  "desiredSchema": {
