{
  "apiVersion": "container.forms.takoform.com",
  "kind": "ContainerEndpoint",
  "definitionVersion": "0.1.0",
  "title": "Container Endpoint",
  "description": "Host-assigned HTTPS reachability for the active Container Traffic. The address is output, not desired state, and remains stable for the attachment UID.",
  "role": "attachment",
  "requiresHostApi": "forms.takoform.com/v1",
  "constraints": [
    {
      "kind": "exclusive",
      "reference": "/service"
    },
    {
      "kind": "hostAssigned",
      "output": "/hostname"
    },
    {
      "kind": "hostAssigned",
      "output": "/url"
    }
  ],
  "desiredSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Host-assigned HTTPS reachability for the active Container Traffic. The address is output, not desired state, and remains stable for the attachment UID.",
    "properties": {
      "service": {
        "additionalProperties": false,
        "description": "Container Service whose active traffic receives HTTPS requests. Changing it replaces the endpoint.",
        "properties": {
          "apiVersion": {
            "const": "container.forms.takoform.com",
            "type": "string"
          },
          "kind": {
            "const": "ContainerService",
            "type": "string"
          },
          "name": {
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$",
            "type": "string"
          }
        },
        "required": [
          "apiVersion",
          "kind",
          "name"
        ],
        "type": "object",
        "x-takoform-required-entrypoint": "http",
        "x-takoform-target-formrefs": [
          {
            "apiVersion": "container.forms.takoform.com",
            "definitionVersion": "0.1.0",
            "kind": "ContainerService",
            "schemaDigest": "sha256:710993f0cebc6c70191ff19b2399efb5c1e66af5df005a7b87ff53e6a5b7c2da"
          }
        ]
      }
    },
    "required": [
      "service"
    ],
    "title": "Container Endpoint desired state",
    "type": "object"
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Host-computed values this Form publishes in status.outputs. Every member is returned by a conforming host; the object is closed.",
    "properties": {
      "hostname": {
        "description": "Canonical DNS hostname assigned by the host. Its shape is host detail and must not be reconstructed.",
        "maxLength": 253,
        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$",
        "type": "string"
      },
      "url": {
        "description": "Exactly https:// plus the assigned hostname and a root slash.",
        "maxLength": 262,
        "pattern": "^https://[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+/$",
        "type": "string"
      }
    },
    "required": [
      "hostname",
      "url"
    ],
    "title": "Container Endpoint outputs",
    "type": "object"
  },
  "immutableFields": [
    "/service"
  ],
  "lifecycleCapabilities": [
    "create",
    "read",
    "delete",
    "import",
    "observe"
  ],
  "conformanceFixtures": [
    {
      "name": "canonical",
      "desiredPath": "fixtures/desired.json"
    }
  ],
  "negativeConformanceFixtures": [
    {
      "name": "reject-unexpected-property",
      "stage": "desired",
      "inputPath": "fixtures/negative-unexpected-property.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-missing-service",
      "stage": "desired",
      "inputPath": "fixtures/negative-missing-service.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-service",
      "stage": "desired",
      "inputPath": "fixtures/negative-service.json",
      "expectedFailure": "schema_validation_failed"
    }
  ]
}
