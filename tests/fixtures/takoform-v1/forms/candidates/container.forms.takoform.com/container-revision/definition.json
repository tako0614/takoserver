    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Immutable serving snapshot of one Container Service: a digest-pinned OCI image, process arguments, environment declarations, sealed slots, and resource and scaling bounds.",
    "properties": {
      "args": {
        "description": "Optional process argument override. Without it the image's default arguments apply; argument order is preserved.",
        "items": {
          "maxLength": 256,
          "pattern": "^[^\\x00\\r\\n]{1,256}$",
          "type": "string"
        },
        "maxItems": 64,
        "type": "array"
      },
      "command": {
        "description": "Optional process entrypoint override. Without it the image's declared entrypoint applies; argument order is preserved.",
        "items": {
          "maxLength": 256,
          "pattern": "^[^\\x00\\r\\n]{1,256}$",
          "type": "string"
        },
        "maxItems": 64,
        "type": "array"
      },
      "concurrencyTarget": {
        "description": "Maximum concurrent HTTP requests delivered to one ready instance.",
        "maximum": 1000,
        "minimum": 1,
        "type": "integer"
      },
      "cpu": {
        "description": "Compute allocation for one serving instance, in millicpu units.",
        "maximum": 16000,
        "minimum": 1,
        "type": "integer"
      },
      "externalServices": {
        "default": [],
        "description": "Sealed slots naming only a standard protocol and a projected NAME. The host resolves endpoint and credentials out of band; neither is portable state. Omitting it declares no external service.",
        "items": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "maxLength": 64,
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "type": "string"
            },
            "required": {
              "default": true,
              "description": "Optional, defaulting to true. A REQUIRED slot the host cannot satisfy blocks readiness; an optional one it does not satisfy projects nothing and blocks nothing.",
              "type": "boolean"
            },
            "service": {
              "additionalProperties": false,
              "properties": {
                "apiVersion": {
                  "const": "standards.takoform.com/v1"
                },
                "protocol": {
                  "maxLength": 253,
                  "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?){2,}$",
                  "type": "string"
                }
              },
              "required": [
                "apiVersion",
                "protocol"
              ],
              "type": "object"
            }
          },
          "required": [
            "name",
            "service"
          ],
          "type": "object"
        },
        "maxItems": 16,
        "type": "array",
        "uniqueItems": true,
        "x-takoform-standard-services": "standards.takoform.com/v1"
      },
      "image": {
        "description": "OCI image reference pinned by a sha256 digest. A mutable tag is not portable state; the host resolves and retains the digest-pinned image before serving.",
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*@sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "maxInstances": {
        "description": "Upper bound on serving instances.",
        "maximum": 1000,
        "minimum": 1,
        "type": "integer"
      },
      "memoryMiB": {
        "description": "Usable memory bound for one serving instance, in MiB.",
        "maximum": 32768,
        "minimum": 128,
        "type": "integer"
      },
      "minInstances": {
        "description": "Lower bound on serving instances. Zero permits scale-to-zero.",
        "maximum": 1000,
        "minimum": 0,
        "type": "integer"
      },
      "requiredSensitiveVars": {
        "default": [],
        "description": "Names of sensitive values the host must supply through its sealed path. Only names are portable state; omitting it requires no sensitive value.",
        "items": {
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
          "type": "string"
        },
        "maxItems": 64,
        "type": "array",
        "uniqueItems": true
      },
      "service": {
        "additionalProperties": false,
        "description": "Container Service identity this immutable revision belongs to.",
        "properties": {
          "apiVersion": {
            "const": "container.forms.takoform.com",
            "type": "string"
          },
          "kind": {
            "const": "ContainerService",
            "type": "string"
          },
          "name": {
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$",
            "type": "string"
          }
        },
        "required": [
          "apiVersion",
          "kind",
          "name"
        ],
        "type": "object",
        "x-takoform-target-formrefs": [
          {
            "apiVersion": "container.forms.takoform.com",
            "definitionVersion": "0.1.0",
            "kind": "ContainerService",
            "schemaDigest": "sha256:710993f0cebc6c70191ff19b2399efb5c1e66af5df005a7b87ff53e6a5b7c2da"
          }
        ]
      },
      "timeoutSeconds": {
        "description": "Maximum wall-clock time for one request before the host fails it, in seconds.",
        "maximum": 3600,
        "minimum": 1,
        "type": "integer"
      },
      "vars": {
        "additionalProperties": {
          "$ref": "#/$defs/jsonValueDepth1"
        },
        "default": {},
        "description": "Non-secret configuration values projected into the process environment. Omitting it projects no variable; sensitive material never enters portable state.",
        "maxProperties": 64,
        "propertyNames": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$",
          "type": "string",
          "x-takoform-fieldPolicy": "portable-data-only-v1"
        },
        "type": "object"
      }
    },
    "required": [
      "concurrencyTarget",
      "cpu",
      "image",
      "maxInstances",
      "memoryMiB",
      "minInstances",
      "service",
      "timeoutSeconds"
    ],
    "title": "Container Revision desired state",
    "type": "object"
  },
  "immutableFields": [
    "/args",
    "/command",
    "/concurrencyTarget",
    "/cpu",
    "/externalServices",
    "/image",
    "/maxInstances",
    "/memoryMiB",
    "/minInstances",
    "/requiredSensitiveVars",
    "/service",
    "/timeoutSeconds",
    "/vars"
  ],
  "lifecycleCapabilities": [
    "create",
    "read",
    "delete",
    "import",
    "observe"
  ],
