  "kind": "ContainerRevision",
  "definitionVersion": "0.1.0",
  "title": "Container Revision",
  "description": "Immutable serving snapshot of one Container Service: a digest-pinned OCI image, process arguments, environment declarations, sealed slots, and resource and scaling bounds.",
  "role": "revision",
