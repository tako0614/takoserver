{
  "cron": "*/5 * * * *",
  "paused": false,
  "retryPolicy": {
    "maxAttempts": 3,
    "retryDelaySeconds": 60
  },
  "target": {
    "attributes": {
      "source": "schedule"
    },
    "body": {
      "data": true,
      "encoding": "utf8"
    },
    "queue": {
      "apiVersion": "queue.forms.takoform.com",
      "kind": "PullQueue",
      "name": "scheduled-work"
    },
    "type": "queueMessage"
  }
}
