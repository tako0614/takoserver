{
  "id": "077-private-auth-marked-absent",
  "category": "registry-auth",
  "description": "An auth object with present false cannot access a private registry.",
  "input": {
    "imageRef": "registry.example.test/workload@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "platform": {
      "os": "linux",
      "architecture": "amd64"
    },
    "registry": {
      "visibility": "private",
      "auth": {
        "present": false,
        "authorized": false
      }
    },
    "manifest": {
      "kind": "image",
      "digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "platform": {
        "os": "linux",
        "architecture": "amd64"
      },
      "sizeBytes": 4096
    }
  },
  "expected": {
    "decision": "reject",
    "reason": "registry_auth_required"
  }
}
