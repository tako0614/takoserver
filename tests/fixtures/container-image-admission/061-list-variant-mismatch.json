{
  "id": "061-list-variant-mismatch",
  "category": "manifest-list",
  "description": "A list with only ARM v6 cannot satisfy an ARM v7 request.",
  "input": {
    "imageRef": "registry.example.test/workload@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "platform": {
      "os": "linux",
      "architecture": "arm",
      "variant": "v7"
    },
    "registry": {
      "visibility": "public"
    },
    "manifest": {
      "kind": "list",
      "digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "manifests": [
        {
          "kind": "image",
          "digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "platform": {
            "os": "linux",
            "architecture": "arm",
            "variant": "v6"
          },
          "sizeBytes": 4096
        }
      ]
    }
  },
  "expected": {
    "decision": "reject",
    "reason": "platform_mismatch"
  }
}
