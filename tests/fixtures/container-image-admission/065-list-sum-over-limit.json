        {
          "kind": "image",
          "digest": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
          "platform": {
            "os": "linux",
            "architecture": "arm64",
            "variant": "v8"
          },
          "sizeBytes": 1100000000
        }
      ]
    }
  },
  "expected": {
