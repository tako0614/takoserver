{
  "id": "051-list-one-image",
  "category": "manifest-list",
  "description": "A pinned list resolves its one matching image digest.",
  "input": {
    "imageRef": "registry.example.test/workload@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "platform": {
      "os": "linux",
      "architecture": "amd64"
    },
    "registry": {
      "visibility": "public"
    },
    "manifest": {
      "kind": "list",
      "digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "manifests": [
        {
          "kind": "image",
          "digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "platform": {
            "os": "linux",
            "architecture": "amd64"
          },
          "sizeBytes": 8192
        }
      ]
    }
  },
  "expected": {
    "decision": "accept",
    "digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    "sizeBytes": 8192,
    "platform": {
      "os": "linux",
      "architecture": "amd64"
    }
  }
}
