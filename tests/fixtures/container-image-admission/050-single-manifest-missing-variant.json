    "manifest": {
      "kind": "image",
      "digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "platform": {
        "os": "linux",
        "architecture": "arm64"
      },
      "sizeBytes": 4096
    }
  },
  "expected": {
    "decision": "reject",
    "reason": "platform_mismatch"
