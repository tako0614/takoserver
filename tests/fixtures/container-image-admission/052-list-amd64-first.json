{
  "id": "052-list-amd64-first",
  "category": "manifest-list",
  "description": "A multi-platform list selects amd64 instead of its arm64 image.",
  "input": {
    "imageRef": "registry.example.test/workload@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "platform": {
      "os": "linux",
      "architecture": "amd64"
    },
    "registry": {
      "visibility": "public"
    },
    "manifest": {
      "kind": "list",
      "digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "manifests": [
        {
          "kind": "image",
          "digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "platform": {
            "os": "linux",
            "architecture": "amd64"
          },
          "sizeBytes": 8192
        },
        {
          "kind": "image",
          "digest": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
          "platform": {
            "os": "linux",
            "architecture": "arm64",
            "variant": "v8"
          },
          "sizeBytes": 16384
        }
      ]
    }
  },
  "expected": {
    "decision": "accept",
    "digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    "sizeBytes": 8192,
    "platform": {
      "os": "linux",
      "architecture": "amd64"
    }
  }
}
