{
  "id": "083-private-tag-with-auth",
  "category": "registry-auth",
  "description": "Private-registry authentication does not make a tag-only reference immutable.",
  "input": {
    "imageRef": "registry.example.test/workload:latest",
    "platform": {
      "os": "linux",
      "architecture": "amd64"
    },
    "registry": {
      "visibility": "private",
      "auth": {
        "present": true,
        "authorized": true
      }
    },
    "manifest": {
      "kind": "image",
      "digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "platform": {
        "os": "linux",
        "architecture": "amd64"
      },
      "sizeBytes": 4096
    }
  },
  "expected": {
    "decision": "reject",
    "reason": "digest_pin_required"
  }
}
