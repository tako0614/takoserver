{
  "name": "@takoserver/core",
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "fmt": "biome check --write .",
    "fmt:check": "biome check .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "test": "bun test",
    "build": "bun scripts/build.ts",
    "build:worker": "bun scripts/build-worker.ts",
    "check:imports": "bun scripts/check-imports.ts",
    "check:official-forms": "bun scripts/check-official-forms.ts",
    "check:migrations": "bun scripts/check-d1-migrations.ts",
    "check:openapi": "bun scripts/check-openapi.ts",
    "check:worker-startup": "bun scripts/check-worker-startup.ts",
    "conformance:takoform-v1": "bun scripts/conformance-takoform-v1.ts",
    "check:worker-types": "wrangler types worker-configuration.d.ts --check --include-runtime=false --config wrangler.jsonc",
    "debug:stable-local-cloudflare-host": "bun scripts/stable-local-cloudflare-host.ts",
    "openapi:write": "bun scripts/write-openapi.ts",
    "worker:types": "wrangler types worker-configuration.d.ts --include-runtime=false --config wrangler.jsonc",
    "check": "bun run fmt:check && bun run lint && bun run check:imports && bun run check:official-forms && bun run check:worker-types && bun run typecheck && bun run typecheck:worker && bun run typecheck:console && bun run test && bun run check:migrations && bun run build && bun run build:console && bun run build:site && bun run build:worker && bun run check:worker-startup && bun run check:openapi && bun run check:schema",
    "deploy": "bun scripts/deploy.ts",
    "schema:write": "bun scripts/write-schema.ts",
    "check:schema": "bun scripts/check-schema.ts",
    "typecheck:console": "tsc --noEmit -p tsconfig.console.json",
    "build:console": "bun scripts/build-console.ts",
    "build:site": "bun scripts/build-site.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@cloudflare/workers-types": "5.20260817.1",
    "@types/bun": "^1.2.20",
    "typescript": "^5.9.2",
    "wrangler": "^4.123.0"
  },
  "dependencies": {
    "acorn": "^8.15.0",
    "drizzle-orm": "^0.45.2"
  }
}
