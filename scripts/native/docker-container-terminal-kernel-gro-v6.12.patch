+/* GRO holds both skb headers while the payload is still on from. Clone
+ * its genuine opaque refs before restore can allocate/COW destination storage.
+ * The existing restore poisons any origin it cannot retain before unwind.
+ */
+void tako_terminal_skb_merge(struct sk_buff *to, const struct sk_buff *from)
+{
+	struct tako_terminal_skb_refs held = {0};
+
+	if (to == from)
+		return;
+	tako_skb_snapshot(from, &held);
+	tako_skb_restore(to, &held);
+}
