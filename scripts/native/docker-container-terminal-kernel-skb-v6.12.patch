+#ifdef CONFIG_TAKO_TERMINAL
+static void tako_skb_snapshot(const struct sk_buff *skb,
+			      struct tako_terminal_skb_refs *held)
+{
+	const struct tako_terminal_skb_refs *refs;
+
+	refs = skb_ext_find(skb, SKB_EXT_TAKO_TERMINAL);
+	if (refs)
+		tako_terminal_skb_refs_clone(held, refs);
+}
+
+static void tako_skb_restore(struct sk_buff *skb,
+			     struct tako_terminal_skb_refs *held)
+{
+	struct tako_terminal_skb_refs *refs;
+
+	if (!tako_terminal_skb_refs_any(held))
+		return;
+	refs = skb_ext_add(skb, SKB_EXT_TAKO_TERMINAL);
+	if (refs) {
+		tako_terminal_skb_refs_merge(refs, held);
+	} else {
+		/* A live packet lost a transfer: poison before its reservation put. */
+		tako_terminal_skb_refs_poison(held);
+		tako_terminal_skb_refs_put(held);
+	}
+}
+
+void tako_terminal_skb_poison(const struct sk_buff *skb)
+{
+	const struct tako_terminal_skb_refs *refs;
+
+	refs = skb_ext_find(skb, SKB_EXT_TAKO_TERMINAL);
+	if (refs)
+		tako_terminal_skb_refs_poison(refs);
+}
+EXPORT_SYMBOL_GPL(tako_terminal_skb_poison);
+
+void tako_terminal_skb_set_owner(struct sk_buff *skb, struct net *net)
+{
+	struct tako_terminal_skb_refs held = {0};
+
+	/* Caller holds the actual socket's net, never a namespace descriptor. */
+	tako_terminal_skb_refs_take(&held, tako_terminal_packet_reserve(net));
+	tako_skb_restore(skb, &held);
+}
+EXPORT_SYMBOL_GPL(tako_terminal_skb_set_owner);
+
+void tako_terminal_skb_copy(struct sk_buff *dst, const struct sk_buff *src)
+{
+	struct tako_terminal_skb_refs held = {0};
+
+	if (dst == src)
+		return;
+	tako_skb_snapshot(dst, &held);
+	skb_ext_put_final(dst);
+	__skb_ext_copy(dst, src);
+	tako_skb_restore(dst, &held);
+}
+EXPORT_SYMBOL_GPL(tako_terminal_skb_copy);
+
+void tako_terminal_skb_reset(struct sk_buff *skb)
+{
+	struct tako_terminal_skb_refs held = {0};
+
+	if (!skb->active_extensions)
+		return;
+	tako_skb_snapshot(skb, &held);
+	skb_ext_put_final(skb);
+	skb->active_extensions = 0;
+	skb->extensions = NULL;
+	/* Rebuild only the private tag: scrubbed protocol metadata stays gone. */
+	tako_skb_restore(skb, &held);
+}
+EXPORT_SYMBOL_GPL(tako_terminal_skb_reset);
+#endif
