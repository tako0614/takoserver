+/* File and heap owner hold independent references. No ctx pointer escapes
+ * into this anchor. Only the actual last-owner destructor publishes freed.
+ */
+struct tako_terminal_join {
+	refcount_t refs;
+	struct completion freed;
+	u64 birth_cookie, birth_inum;
+	u64 final_cookie, final_inum;
+	unsigned int failed;
+};
+
 struct tako_terminal_owner {
 	refcount_t refs; /* original file + net + each reserved object */
+	struct tako_terminal_join *join;
 	spinlock_t lock;
 	struct tako_terminal_state state;
 	struct tako_terminal_admission admission;
@@ -55,12 +68,65 @@
 	struct net *net;
 	struct tako_terminal_owner *owner; /* independent of ctx->net */
 	unsigned int attempted;
+	struct tako_terminal_join *join;
+	unsigned int join_attempted;
 };
 
+static bool tako_admission_poisoned(const struct tako_terminal_owner *owner);
+
+static void tako_join_put(struct tako_terminal_join *join)
+{
+	if (join && refcount_dec_and_test(&join->refs))
+		kfree(join);
+}
+
+static int tako_join_attach(struct tako_terminal_file *ctx,
+			    struct tako_terminal_owner *owner)
+{
+	struct tako_terminal_join *join = kzalloc(sizeof(*join), GFP_KERNEL);
+
+	if (!join)
+		return -ENOMEM;
+	refcount_set(&join->refs, 2); /* original file and actual heap owner */
+	init_completion(&join->freed);
+	ctx->join = join;
+	owner->join = join;
+	return 0;
+}
+
 static void tako_owner_put(struct tako_terminal_owner *owner)
 {
-	if (owner && refcount_dec_and_test(&owner->refs))
-		kfree(owner);
+	struct tako_terminal_join *join;
+	unsigned long flags;
+
+	if (!owner || !refcount_dec_and_test(&owner->refs))
+		return;
+	join = owner->join;
+	if (join) {
+		/* Preserve the original poison/admission read lock contract, even
+		 * at the actual last reference, before actual heap free.
+		 */
+		spin_lock_irqsave(&owner->lock, flags);
+		join->final_cookie = owner->net_cookie;
+		join->final_inum = owner->namespace_inum;
+		join->failed = tako_admission_poisoned(owner) ||
+			!owner->admission.cut || owner->admission.opened ||
+			!owner->state.sealed || !owner->device_associations.sealed ||
+			!owner->lifetime.born || !owner->lifetime.release_attempted ||
+			!owner->lifetime.reference_released || !owner->lifetime.net_gone ||
+			!join->birth_cookie || !join->birth_inum ||
+			join->birth_cookie != join->final_cookie ||
+			join->birth_inum != join->final_inum;
+		spin_unlock_irqrestore(&owner->lock, flags);
+	}
+	kfree(owner);
+	if (join) {
+		/* Only saved anchor memory is touched after owner heap free.
+		 * READ never waits/consumes/resets this one permanent event.
+		 */
+		complete(&join->freed);
+		tako_join_put(join);
+	}
 }
 
 void tako_terminal_net_attach(struct net *net, struct tako_terminal_owner *owner)
@@ -459,6 +525,71 @@
 	spin_lock_irqsave(&owner->lock, flags);
 	tako_terminal_lifetime_reference_put(&owner->lifetime);
 	spin_unlock_irqrestore(&owner->lock, flags);
+	return 0;
+}
+
+/* Original context mutex is held. Neither command accepts a target or
+ * observed count/flags; completion is tracked-owner destruction only.
+ */
+static int tako_join_caller(const struct tako_terminal_file *ctx)
+{
+	return ctx->creator == task_tgid(current) &&
+		ns_capable(&init_user_ns, CAP_SYS_ADMIN) &&
+		ns_capable(&init_user_ns, CAP_NET_ADMIN);
+}
+
+static int tako_join_begin(struct tako_terminal_file *ctx)
+{
+	struct tako_terminal_owner *owner = ctx->owner;
+	struct tako_terminal_join *join = ctx->join;
+	unsigned long flags;
+	bool valid;
+
+	if (!tako_join_caller(ctx))
+		return -EPERM;
+	if (ctx->join_attempted)
+		return -EALREADY;
+	if (!owner || !join || owner->join != join)
+		return -ENODATA;
+	if (ctx->net)
+		return -EBUSY;
+	spin_lock_irqsave(&owner->lock, flags);
+	valid = owner->lifetime.born && owner->lifetime.release_attempted &&
+		owner->lifetime.reference_released && owner->admission.cut &&
+		!owner->admission.opened && owner->state.sealed &&
+		owner->device_associations.sealed && join->birth_cookie &&
+		join->birth_inum && join->birth_cookie == owner->net_cookie &&
+		join->birth_inum == owner->namespace_inum;
+	spin_unlock_irqrestore(&owner->lock, flags);
+	if (!valid)
+		return -EUCLEAN;
+	/* Consumed before the only file-owner reference handoff. Original
+	 * ctx->attempted is never reset: CREATE remains permanently one-use.
+	 */
+	if (!tako_terminal_consume_birth(&ctx->join_attempted))
+		return -EALREADY;
+	ctx->owner = NULL;
+	tako_owner_put(owner);
+	return 0;
+}
+
+static int tako_join_read(struct tako_terminal_file *ctx)
+{
+	struct tako_terminal_join *join = ctx->join;
+
+	if (!tako_join_caller(ctx))
+		return -EPERM;
+	if (!ctx->join_attempted || ctx->owner || !join)
+		return -ENODATA;
+	/* Private anchor has no wait/try/reset consumers. completion_done
+	 * synchronizes with the finishing complete lock without consuming it.
+	 */
+	if (!completion_done(&join->freed))
+		return -EAGAIN;
+	if (join->failed || !join->birth_cookie || !join->birth_inum ||
+	    join->birth_cookie != join->final_cookie ||
+	    join->birth_inum != join->final_inum)
+		return -EUCLEAN;
 	return 0;
 }
 
