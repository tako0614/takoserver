+void tako_terminal_device_poison(struct tako_terminal_owner *owner)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&owner->lock, flags);
+	owner->device_associations.poisoned = 1;
+	spin_unlock_irqrestore(&owner->lock, flags);
+}
+
+void tako_terminal_device_record(struct net_device *dev, struct net *net)
+{
+	struct tako_terminal_owner *owner = net ? net->tako_terminal : NULL;
+
+	if (!owner)
+		return;
+	/* Original dev_net_set target is live. Counter/ref BEFORE publication;
+	 * failure/duplicate unwind cannot discard any prior association.
+	 */
+	tako_aux_get(owner, &owner->device_associations);
+	tako_terminal_device_refs_take(&dev->tako_terminal_origins, owner);
+}
+/* dev_net_set was already public inline API; no new GPL-only restriction. */
+EXPORT_SYMBOL(tako_terminal_device_record);
