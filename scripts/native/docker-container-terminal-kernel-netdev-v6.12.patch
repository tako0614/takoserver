 EXPORT_SYMBOL_GPL(tako_terminal_skb_poison);
 
+/* Only the original valid device allocation must remain alive here. Its
+ * published association refs outlive net memory, unregister and migration.
+ * No raw namespace pointer is read at any receive/transmit entry.
+ */
+void tako_terminal_skb_from_dev(struct sk_buff *skb)
+{
+	struct tako_terminal_skb_refs held = {0};
+	struct net_device *dev = skb->dev;
+	unsigned int i;
+
+	if (unlikely(!dev)) {
+		tako_terminal_skb_poison(skb);
+		return;
+	}
+	for (i = 0; i < TAKO_TERMINAL_DEVICE_ORIGINS; i++) {
+		struct tako_terminal_owner *owner;
+
+		owner = smp_load_acquire(&dev->tako_terminal_origins.owners[i]);
+		tako_terminal_skb_refs_take(&held,
+					  tako_terminal_packet_clone(owner));
+	}
+	tako_skb_restore(skb, &held);
+}
+EXPORT_SYMBOL_GPL(tako_terminal_skb_from_dev);
+
 void tako_terminal_skb_set_owner(struct sk_buff *skb, struct net *net)
 {
 	struct tako_terminal_skb_refs held = {0};
