+++ b/net/core/tako_terminal.c
@@ -0,0 +1,539 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Linux v6.12 first mechanical ownership unit. This is NOT a full lifetime
+ * barrier: skb/queues, device/offload continuations,
+ * and release certification are deliberately not exported as completed.
+ * No operation can open this namespace's birth-deny gate.
+ */
+#include <linux/capability.h>
+#include <linux/compat.h>
+#include <linux/cred.h>
+#include <linux/file.h>
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/miscdevice.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/netfilter.h>
+#include <linux/pid.h>
+#include <linux/path.h>
+#include <linux/proc_ns.h>
+#include <linux/refcount.h>
+#include <linux/sched.h>
+#include <linux/sched/signal.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/tako_terminal.h>
+#include <linux/tako_terminal_state.h>
+#include <linux/tako_terminal_lifetime.h>
+#include <linux/uaccess.h>
+#include <linux/user_namespace.h>
+#include <net/net_namespace.h>
+#include <net/sock.h>
+#include <net/request_sock.h>
+#include <net/inet_timewait_sock.h>
+#include <uapi/linux/tako_terminal.h>
+
+struct tako_terminal_owner {
+	refcount_t refs; /* original file + net + each reserved object */
+	spinlock_t lock;
+	struct tako_terminal_state state;
+	struct tako_terminal_state requests;
+	struct tako_terminal_state timewait;
+	struct tako_terminal_state packet_groups;
+	struct tako_terminal_lifetime lifetime;
+	u64 net_cookie;
+	u64 namespace_inum;
+};
+
+struct tako_terminal_file {
+	struct mutex lock;
+	struct pid *creator;
+	struct net *net;
+	struct tako_terminal_owner *owner; /* independent of ctx->net */
+	unsigned int attempted;
+};
+
+static void tako_owner_put(struct tako_terminal_owner *owner)
+{
+	if (owner && refcount_dec_and_test(&owner->refs))
+		kfree(owner);
+}
+
+void tako_terminal_net_attach(struct net *net, struct tako_terminal_owner *owner)
+{
+	/* Called on newly zero-allocated, unpublished net BEFORE preinit/setup.
+	 * This is not an adoption API and has no exported module symbol.
+	 */
+	if (owner) {
+		unsigned long flags;
+
+		refcount_inc(&owner->refs);
+		spin_lock_irqsave(&owner->lock, flags);
+		tako_terminal_lifetime_born(&owner->lifetime);
+		spin_unlock_irqrestore(&owner->lock, flags);
+		net->tako_terminal = owner;
+	}
+}
+
+struct tako_terminal_owner *tako_terminal_net_detach(struct net *net)
+{
+	/* Transfer the final net allocation's ledger reference into the local
+	 * net_free variable. No read of net memory is allowed after slab free.
+	 */
+	return net->tako_terminal;
+}
+
+void tako_terminal_net_freed(struct tako_terminal_owner *owner)
+{
+	unsigned long flags;
+
+	if (!owner)
+		return;
+	/* Called ONLY after actual final net kmem_cache_free, never an ioctl
+	 * or a userspace ACK/boolean. Standalone original file/sock refs can
+	 * keep this ledger observable beyond namespace memory destruction.
+	 */
+	spin_lock_irqsave(&owner->lock, flags);
+	tako_terminal_lifetime_net_freed(&owner->lifetime);
+	spin_unlock_irqrestore(&owner->lock, flags);
+	tako_owner_put(owner);
+}
+
+void tako_terminal_sock_init(struct sock *sk)
+{
+	sk->sk_tako_terminal = NULL;
+}
+
+static void tako_sock_get(struct tako_terminal_owner *owner)
+{
+	unsigned long flags;
+
+	if (!owner)
+		return;
+	refcount_inc(&owner->refs);
+	spin_lock_irqsave(&owner->lock, flags);
+	tako_terminal_state_get(&owner->state);
+	spin_unlock_irqrestore(&owner->lock, flags);
+}
+
+struct tako_terminal_owner *tako_terminal_sock_reserve(struct net *net, int family)
+{
+	struct tako_terminal_owner *owner = NULL;
+
+	/* Reserve BEFORE allocation. Protocol is not initialized yet, so count
+	 * ALL full IPv4/IPv6 sockets, including raw/ICMP and kernel sockets.
+	 * In-progress and failing allocation reservations are conservative.
+	 * The net owner exists before pernet init can allocate these objects.
+	 */
+	if (family == AF_INET || family == AF_INET6) {
+		owner = net->tako_terminal;
+		tako_sock_get(owner);
+	}
+	return owner;
+}
+
+struct tako_terminal_owner *tako_terminal_clone_reserve(const struct sock *sk)
+{
+	struct tako_terminal_owner *owner = sk->sk_tako_terminal;
+
+	/* Parent socket retains owner. Reserve a NEW ref before clone malloc,
+	 * including allocator/LSM/module failures before sock_copy is reached.
+	 */
+	tako_sock_get(owner);
+	return owner;
+}
+
+void tako_terminal_sock_attach(struct sock *sk, struct tako_terminal_owner *owner)
+{
+	/* Consume the already-held reservation, without incrementing twice. */
+	sk->sk_tako_terminal = owner;
+}
+
+struct tako_terminal_owner *tako_terminal_sock_detach(struct sock *sk)
+{
+	struct tako_terminal_owner *owner = sk->sk_tako_terminal;
+
+	sk->sk_tako_terminal = NULL;
+	return owner;
+}
+
+void tako_terminal_sock_put(struct tako_terminal_owner *owner)
+{
+	unsigned long flags;
+
+	if (!owner)
+		return;
+	spin_lock_irqsave(&owner->lock, flags);
+	tako_terminal_state_put(&owner->state);
+	spin_unlock_irqrestore(&owner->lock, flags);
+	tako_owner_put(owner);
+}
+
+
+/* Each actual object kind has a separate subcounter but shares the original
+ * allocation's independent ledger lifetime. These do not imply full coverage.
+ */
+static void tako_aux_get(struct tako_terminal_owner *owner,
+			 struct tako_terminal_state *counter)
+{
+	unsigned long flags;
+
+	refcount_inc(&owner->refs);
+	spin_lock_irqsave(&owner->lock, flags);
+	tako_terminal_state_get(counter);
+	spin_unlock_irqrestore(&owner->lock, flags);
+}
+
+static void tako_aux_put(struct tako_terminal_owner *owner,
+			 struct tako_terminal_state *counter)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&owner->lock, flags);
+	tako_terminal_state_put(counter);
+	spin_unlock_irqrestore(&owner->lock, flags);
+	tako_owner_put(owner);
+}
+
+struct tako_terminal_owner *tako_terminal_request_reserve(const struct sock *sk)
+{
+	struct tako_terminal_owner *owner = sk->sk_tako_terminal;
+
+	if (owner)
+		tako_aux_get(owner, &owner->requests);
+	return owner;
+}
+
+struct tako_terminal_owner *
+tako_terminal_request_clone_reserve(const struct request_sock *req)
+{
+	struct tako_terminal_owner *owner = req->rsk_tako_terminal;
+
+	if (owner)
+		tako_aux_get(owner, &owner->requests);
+	return owner;
+}
+
+void tako_terminal_request_attach(struct request_sock *req,
+				   struct tako_terminal_owner *owner)
+{
+	req->rsk_tako_terminal = owner;
+}
+
+struct tako_terminal_owner *tako_terminal_request_detach(struct request_sock *req)
+{
+	struct tako_terminal_owner *owner = req->rsk_tako_terminal;
+
+	req->rsk_tako_terminal = NULL;
+	return owner;
+}
+EXPORT_SYMBOL_GPL(tako_terminal_request_detach);
+
+void tako_terminal_request_put(struct tako_terminal_owner *owner)
+{
+	if (owner)
+		tako_aux_put(owner, &owner->requests);
+}
+EXPORT_SYMBOL_GPL(tako_terminal_request_put);
+
+struct tako_terminal_owner *tako_terminal_timewait_reserve(const struct sock *sk)
+{
+	struct tako_terminal_owner *owner = sk->sk_tako_terminal;
+
+	if (owner)
+		tako_aux_get(owner, &owner->timewait);
+	return owner;
+}
+
+void tako_terminal_timewait_attach(struct inet_timewait_sock *tw,
+				    struct tako_terminal_owner *owner)
+{
+	tw->tw_tako_terminal = owner;
+}
+
+struct tako_terminal_owner *tako_terminal_timewait_detach(struct inet_timewait_sock *tw)
+{
+	struct tako_terminal_owner *owner = tw->tw_tako_terminal;
+
+	tw->tw_tako_terminal = NULL;
+	return owner;
+}
+
+void tako_terminal_timewait_put(struct tako_terminal_owner *owner)
+{
+	if (owner)
+		tako_aux_put(owner, &owner->timewait);
+}
+
+struct tako_terminal_owner *tako_terminal_packet_reserve(struct net *net)
+{
+	struct tako_terminal_owner *owner = net->tako_terminal;
+
+	if (owner)
+		tako_aux_get(owner, &owner->packet_groups);
+	return owner;
+}
+
+struct tako_terminal_owner *tako_terminal_packet_clone(struct tako_terminal_owner *held)
+{
+	if (held)
+		tako_aux_get(held, &held->packet_groups);
+	return held;
+}
+
+void tako_terminal_packet_put(struct tako_terminal_owner *held)
+{
+	if (held)
+		tako_aux_put(held, &held->packet_groups);
+}
+
+void tako_terminal_packet_poison(struct tako_terminal_owner *held)
+{
+	unsigned long flags;
+
+	if (!held)
+		return;
+	spin_lock_irqsave(&held->lock, flags);
+	held->packet_groups.poisoned = 1;
+	spin_unlock_irqrestore(&held->lock, flags);
+}
+
+bool tako_terminal_block(const struct net *net, u8 pf)
+{
+	/* Pointer is immutable from before setup_net to final net_free. The
+	 * gate has no OPEN transition in this partial source unit. Counts,
+	 * userspace booleans and ACKs cannot authorize a packet or retirement.
+	 * Common NF dispatch coverage is not a claim about all device paths.
+	 */
+	return net->tako_terminal && (pf == NFPROTO_IPV4 || pf == NFPROTO_IPV6);
+}
+EXPORT_SYMBOL_GPL(tako_terminal_block);
+
+static void tako_seal(struct tako_terminal_owner *owner)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&owner->lock, flags);
+	tako_terminal_state_seal(&owner->state);
+	spin_unlock_irqrestore(&owner->lock, flags);
+}
+
+static int tako_release_namespace(struct tako_terminal_file *ctx)
+{
+	struct tako_terminal_owner *owner = ctx->owner;
+	struct net *net = ctx->net;
+	unsigned long flags;
+
+	if (!net)
+		return -EALREADY;
+	spin_lock_irqsave(&owner->lock, flags);
+	if (!tako_terminal_lifetime_release_attempt(&owner->lifetime)) {
+		spin_unlock_irqrestore(&owner->lock, flags);
+		return -EALREADY;
+	}
+	tako_terminal_state_seal(&owner->state);
+	spin_unlock_irqrestore(&owner->lock, flags);
+	/* Clear the original context BEFORE the one raw put, never adopt or
+	 * drop another FD/PID's namespace. File ref keeps owner independently.
+	 */
+	ctx->net = NULL;
+	put_net(net);
+	spin_lock_irqsave(&owner->lock, flags);
+	tako_terminal_lifetime_reference_put(&owner->lifetime);
+	spin_unlock_irqrestore(&owner->lock, flags);
+	return 0;
+}
+
+static struct ns_common *tako_ns_get(void *arg)
+{
+	struct net *net = arg;
+
+	return &get_net(net)->ns;
+}
+
+static int tako_namespace_fd(struct net *net)
+{
+	struct path path;
+	struct file *file;
+	int fd, ret;
+
+	/* ns_get_path_cb consumes the callback's net reference on all paths. */
+	ret = ns_get_path_cb(&path, tako_ns_get, net);
+	if (ret)
+		return ret;
+	file = dentry_open(&path, O_RDONLY, current_cred());
+	path_put(&path);
+	if (IS_ERR(file))
+		return PTR_ERR(file);
+	fd = get_unused_fd_flags(O_CLOEXEC);
+	if (fd < 0) {
+		fput(file);
+		return fd;
+	}
+	fd_install(fd, file);
+	return fd;
+}
+
+static int tako_open(struct inode *inode, struct file *file)
+{
+	struct tako_terminal_file *ctx;
+
+	/* Deliberately initial-userns operator only; no unprivileged adopter. */
+	if (!ns_capable(&init_user_ns, CAP_SYS_ADMIN) ||
+	    !ns_capable(&init_user_ns, CAP_NET_ADMIN))
+		return -EPERM;
+	ctx = kzalloc(sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+	mutex_init(&ctx->lock);
+	ctx->creator = get_pid(task_tgid(current));
+	file->private_data = ctx;
+	return 0;
+}
+
+static long tako_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	struct tako_terminal_file *ctx = file->private_data;
+	struct tako_terminal_observation out = {};
+	struct tako_terminal_lifetime_observation life = {};
+	struct tako_terminal_owner *owner;
+	unsigned long flags;
+	long ret = -ENOTTY;
+
+	/* The original opener process owns mutation/readback. PID struct
+	 * identity cannot be recycled while this open retains its reference.
+	 */
+	if (ctx->creator != task_tgid(current) ||
+	    !ns_capable(&init_user_ns, CAP_SYS_ADMIN) ||
+	    !ns_capable(&init_user_ns, CAP_NET_ADMIN))
+		return -EPERM;
+	mutex_lock(&ctx->lock);
+	switch (cmd) {
+	case TAKO_TERMINAL_CREATE:
+		if (arg) { ret = -EINVAL; break; }
+		/* Shared tested transition consumes BEFORE allocation/effect. */
+		if (!tako_terminal_consume_birth(&ctx->attempted)) {
+			ret = -EALREADY;
+			break;
+		}
+		owner = kzalloc(sizeof(*owner), GFP_KERNEL);
+		if (!owner) { ret = -ENOMEM; break; }
+		refcount_set(&owner->refs, 1);
+		spin_lock_init(&owner->lock);
+		tako_terminal_state_init(&owner->state);
+		tako_terminal_state_init(&owner->requests);
+		tako_terminal_state_init(&owner->timewait);
+		tako_terminal_state_init(&owner->packet_groups);
+		ctx->owner = owner; /* ORIGINAL file keeps the allocation reference */
+		ctx->net = tako_terminal_new_net(owner);
+		if (IS_ERR(ctx->net)) {
+			ret = PTR_ERR(ctx->net);
+			ctx->net = NULL;
+			break;
+		}
+		spin_lock_irqsave(&owner->lock, flags);
+		owner->net_cookie = ctx->net->net_cookie;
+		owner->namespace_inum = ctx->net->ns.inum;
+		spin_unlock_irqrestore(&owner->lock, flags);
+		ret = tako_namespace_fd(ctx->net);
+		/* Even failure/lost ACK retains this exact born net in ctx->net.
+		 * A second CREATE is refused. There is no replacement/adoption.
+		 */
+		break;
+	case TAKO_TERMINAL_CUT:
+		if (arg) { ret = -EINVAL; break; }
+		/* CUT before CREATE also consumes the original birth attempt. */
+		tako_terminal_consume_birth(&ctx->attempted);
+		if (ctx->owner)
+			tako_seal(ctx->owner);
+		ret = 0;
+		break;
+	case TAKO_TERMINAL_OBSERVE:
+		if (!ctx->owner) { ret = -ENODATA; break; }
+		owner = ctx->owner;
+		spin_lock_irqsave(&owner->lock, flags);
+		out.net_cookie = owner->net_cookie;
+		out.namespace_inum = owner->namespace_inum;
+		out.full_ip_sockets = owner->state.sockets;
+		out.allocations = owner->state.allocations;
+		out.releases = owner->state.releases;
+		out.sealed = owner->state.sealed;
+		out.poisoned = owner->state.poisoned;
+		spin_unlock_irqrestore(&owner->lock, flags);
+		if (!out.net_cookie || !out.namespace_inum) {
+			ret = -EUCLEAN;
+			break;
+		}
+		ret = copy_to_user((void __user *)arg, &out, sizeof(out)) ? -EFAULT : 0;
+		break;
+	case TAKO_TERMINAL_RELEASE_NAMESPACE:
+		if (arg) { ret = -EINVAL; break; }
+		tako_terminal_consume_birth(&ctx->attempted);
+		if (!ctx->owner) { ret = -ENODATA; break; }
+		ret = tako_release_namespace(ctx);
+		break;
+	case TAKO_TERMINAL_LIFETIME:
+		if (!ctx->owner) { ret = -ENODATA; break; }
+		owner = ctx->owner;
+		spin_lock_irqsave(&owner->lock, flags);
+		life.net_cookie = owner->net_cookie;
+		life.namespace_inum = owner->namespace_inum;
+		life.full_ip_sockets = owner->state.sockets;
+		life.requests = owner->requests.sockets;
+		life.timewait = owner->timewait.sockets;
+		life.packet_groups = owner->packet_groups.sockets;
+		life.born = owner->lifetime.born;
+		life.release_attempted = owner->lifetime.release_attempted;
+		life.reference_released = owner->lifetime.reference_released;
+		life.net_gone = owner->lifetime.net_gone;
+		life.poisoned = owner->lifetime.poisoned | owner->state.poisoned |
+			owner->requests.poisoned | owner->timewait.poisoned |
+			owner->packet_groups.poisoned;
+		spin_unlock_irqrestore(&owner->lock, flags);
+		if (!life.net_cookie || !life.namespace_inum) {
+			ret = -EUCLEAN;
+			break;
+		}
+		ret = copy_to_user((void __user *)arg, &life, sizeof(life)) ? -EFAULT : 0;
+		break;
+	}
+	mutex_unlock(&ctx->lock);
+	return ret;
+}
+
+static int tako_release(struct inode *inode, struct file *file)
+{
+	struct tako_terminal_file *ctx = file->private_data;
+
+	/* Closing never grants retirement. Any external net references or
+	 * object references retain the actual net/ledger naturally.
+	 */
+	if (ctx->net)
+		tako_release_namespace(ctx);
+	tako_owner_put(ctx->owner);
+	put_pid(ctx->creator);
+	kfree(ctx);
+	return 0;
+}
+
+static const struct file_operations tako_fops = {
+	.owner = THIS_MODULE,
+	.open = tako_open,
+	.release = tako_release,
+	.unlocked_ioctl = tako_ioctl,
+	.compat_ioctl = compat_ptr_ioctl,
+	.llseek = no_llseek,
+};
+
+static struct miscdevice tako_device = {
+	.minor = MISC_DYNAMIC_MINOR,
+	.name = "tako-terminal",
+	.fops = &tako_fops,
+	.mode = 0600,
+};
+
+static int __init tako_terminal_init(void)
+{
+	return misc_register(&tako_device);
+}
+device_initcall(tako_terminal_init);
