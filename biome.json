{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "files": {
    "includes": [
      "**",
      "!!node_modules",
      "!!dist",
      "!!console/dist",
      "!!site/dist",
      "!!.git",
      "!!openapi/takoserver.openapi.json",
      "!!worker-configuration.d.ts",
      "!!form-authority-worker-configuration.d.ts",
      "!!integration-form-authority-worker-configuration.d.ts",
      "!!integration-form-authority-operator-worker-configuration.d.ts",
      "!!.deploy",
      "!!.wrangler-realized.jsonc",
      "!!src/db-schema.ts",
      "!!vendor/takoform",
      "!!tests/fixtures/takoform-v1"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
